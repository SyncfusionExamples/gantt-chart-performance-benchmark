{
  "name": "bryntum-gantt-benchmark",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@^7.3.5",
    "@bryntum/gantt-react": "^7.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node scripts/generateBundleStats.js",
    "analyze:bundle": "node scripts/generateBundleStats.js",
    "analyze:open": "node -e \"require('child_process').spawn(process.platform==='win32'?'cmd':'open',[process.platform==='win32'?'/c start':'public/bundle-report.html'],{stdio:'inherit',shell:true})\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
